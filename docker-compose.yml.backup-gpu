version: "3.8"

services:
  db:
    image: postgres:15
    volumes:
      - pgdata:/var/lib/postgresql/data
    environment:
      - HSA_OVERRIDE_GFX_VERSION=11.0.0
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${POSTGRES_DB}
    ports:
      - "5432:5432"
    restart: always

  backend:
    build: ./backend
    init: true
    ports:
      - "8000:8000"
    depends_on:
      - db
    security_opt:
      - seccomp:unconfined
    group_add:
      - "44"
      - "990"
    devices:
      - /dev/kfd:/dev/kfd
      - /dev/dri:/dev/dri
    volumes:
      - ./backend:/app
      - ./backend/uploads:/app/uploads
    environment:
      - HSA_OVERRIDE_GFX_VERSION=11.0.0
      - DATABASE_URL=${DATABASE_URL}
      - SECRET_KEY=${SECRET_KEY}
      - HF_TOKEN=${HF_TOKEN}
    command: bash -c "ln -s /opt/rocm/lib/libamdhip64.so.6 /opt/rocm/lib/libamdhip64.so.7 2>/dev/null || true && uvicorn app.main:app --host 0.0.0.0 --port 8000"
    restart: always

  mediamtx:
    image: bluenviron/mediamtx:latest
    ports:
      - "8554:8554"   # RTSP
      - "8889:8889"   # WebRTC
    environment:
      - HSA_OVERRIDE_GFX_VERSION=11.0.0
      - MTX_WEBRTCADDITIONALHOSTS=localhost
    volumes:
      - ./mediamtx.yml:/mediamtx.yml
    restart: always

  frontend:
    image: nginx:alpine
    volumes:
      - ./frontend:/usr/share/nginx/html
      - ./frontend/default.conf:/etc/nginx/conf.d/default.conf
    ports:
      - "80:80"
    depends_on:
      - backend
    restart: always

volumes:
  pgdata:
