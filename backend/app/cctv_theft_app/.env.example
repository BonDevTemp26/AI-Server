# Copy to .env and fill in what you use. All channels are optional and free.

# Stage 3 — VLM verification (configs/vlm_verifier.yaml)
# Default backend: Hugging Face Inference Providers router (free monthly credits).
# Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=
# Only if you switch the endpoint to OpenRouter: https://openrouter.ai/keys
VLM_API_KEY=
# backend: hf_local needs no key at all (model runs locally).

# Telegram alerts (configs/alerts.yaml → channels.telegram)
# Create a bot with @BotFather; get chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack / Discord / generic webhook (configs/alerts.yaml → channels.webhook)
ALERT_WEBHOOK_URL=

# MQTT credentials (only if your broker requires auth)
MQTT_USERNAME=
MQTT_PASSWORD=
